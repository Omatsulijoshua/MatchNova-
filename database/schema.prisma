datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MODERATOR
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SwipeType {
  LIKE
  PASS
  SUPERLIKE
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
  BLOCKED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  CALL_LOG
}

enum SubscriptionTier {
  PREMIUM
  ELITE
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  passwordHash String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  verified     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile        Profile?
  subscriptions  Subscription[]
  sentSwipes     Swipe[]        @relation("SentSwipes")
  receivedSwipes Swipe[]        @relation("ReceivedSwipes")
  messagesSent   Message[]
  reportsFiled   Report[]       @relation("Reporter")
  reportsAgainst Report[]       @relation("Reported")

  @@index([role, status])
}

model Profile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  birthDate         DateTime
  gender            String
  sexualOrientation String
  bio               String?  @db.Text
  photos            String[] // S3/R2 signed URLs or CDN paths
  interests         String[]
  locationLat       Float?   // Precise coordinates (internal use only)
  locationLng       Float?
  locationFuzzyLat  Float?   // Truncated coordinates for client queries
  locationFuzzyLng  Float?
  lastActive        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([gender, birthDate])
  @@index([locationFuzzyLat, locationFuzzyLng])
}

model Swipe {
  id         String    @id @default(uuid()) @db.Uuid
  senderId   String    @db.Uuid
  sender     User      @relation("SentSwipes", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String    @db.Uuid
  receiver   User      @relation("ReceivedSwipes", fields: [receiverId], references: [id], onDelete: Cascade)
  type       SwipeType
  createdAt  DateTime  @default(now())

  @@unique([senderId, receiverId])
  @@index([receiverId, type])
}

model Match {
  id        String      @id @default(uuid()) @db.Uuid
  user1Id   String      @db.Uuid
  user2Id   String      @db.Uuid
  status    MatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([status])
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  matchId   String      @db.Uuid
  match     Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String      @db.Uuid
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String      @db.Text
  type      MessageType @default(TEXT)
  isNSFW    Boolean     @default(false)
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([matchId, createdAt])
}

model Subscription {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           SubscriptionTier
  status         String // e.g. "active", "past_due", "canceled"
  stripeId       String?          @unique // Stripe Subscription ID
  paystackId     String?          @unique
  flutterwaveId  String?          @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, status])
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @db.Uuid
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String       @db.Uuid
  reported   User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  details    String?      @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
}
